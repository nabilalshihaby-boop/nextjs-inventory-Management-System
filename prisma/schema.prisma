// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  USER
}

model User {
  id                   String                @id @default(cuid())
  firstName            String
  lastName             String
  email                String                @unique
  /// bcrypt hash only — never store a plaintext password.
  passwordHash         String
  phoneNumber          String
  image                String?               @db.Text
  role                 Role                  @default(USER)
  /// Bumped whenever all existing sessions must end (password reset/change). Every session read
  /// compares it with the value stored in the encrypted JWT (auth.ts). Never sent to the browser.
  sessionVersion       Int                   @default(0)
  /// bcrypt hash of the optional POS Cashier PIN (OWNER/ADMIN, set on the Profile page). Only unlocks the POS
  /// screen of an already signed-in session - never a login. Independent of passwordHash: a password change or
  /// reset leaves it untouched. Never selected into pages/responses; removed with the user row.
  posPinHash           String?               @db.VarChar(100)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  preference           UserPreference?
  translationOverrides TranslationOverride[] @relation("TranslationOverrideUpdatedBy")

  @@map("users")
}

/// Currencies managed on /currencies. `code` is ISO-style: exactly 3 uppercase letters, unique
/// regardless of case (stored uppercase; the column collation is case-insensitive as well).
model Currency {
  id               String                 @id @default(cuid())
  name             String                 @db.VarChar(100)
  code             String                 @unique @db.Char(3)
  symbol           String                 @db.VarChar(10)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  defaultIn        SystemSettings[]       @relation("DefaultCurrency")
  cashBankAccounts CashBankAccount[]
  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]
  supplierPayments SupplierPayment[]
  quotations       Quotation[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  customerPayments CustomerPayment[]
  denominations    CurrencyDenomination[]

  @@map("currencies")
}

/// Warehouses managed on /warehouse. `name` is unique (case-insensitive column collation).
/// Future stock, sales, purchase and transfer records will reference warehouses; deletion must
/// be refused while such references exist (see app/(dashboard)/warehouse/actions.ts).
model Warehouse {
  id              String              @id @default(cuid())
  name            String              @unique @db.VarChar(120)
  email           String              @db.VarChar(191)
  phoneNumber     String              @db.VarChar(32)
  /// ISO 3166-1 alpha-2 code (see lib/countries.ts).
  countryCode     String              @db.Char(2)
  city            String              @db.VarChar(120)
  zipCode         String?             @db.VarChar(20)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  stocks          ProductStock[]
  stockEntries    ProductStockEntry[]
  transfersOut    StockTransfer[]     @relation("TransferFrom")
  transfersIn     StockTransfer[]     @relation("TransferTo")
  adjustments     StockAdjustment[]
  expenses        Expense[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  quotations      Quotation[]
  sales           Sale[]
  saleReturns     SaleReturn[]

  @@map("warehouses")
}

/// Product categories managed on /products/categories. `name` is unique (case-insensitive
/// column collation). Products will reference categories; deletion is refused while they do.
model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(120)
  /// Relative path under /uploads/product-categories (local-development storage), or null.
  image     String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("product_categories")
}

/// Brands managed on /products/brands. `name` is unique (case-insensitive column collation).
/// Products will reference brands; deletion is refused while they do.
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(120)
  /// Relative path under /uploads/brands (local-development storage), or null.
  image     String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

/// Product units managed on /products/units. `name` is unique (case-insensitive column collation).
/// Products will reference units; deletion is refused while they do.
model ProductUnit {
  id                 String                  @id @default(cuid())
  name               String                  @unique @db.VarChar(120)
  /// Relative path under /uploads/units (local-development storage), or null.
  image              String?                 @db.VarChar(255)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  productsAsUnit     Product[]               @relation("ProductUnit")
  productsAsSale     Product[]               @relation("SaleUnit")
  productsAsPurchase Product[]               @relation("PurchaseUnit")
  conversions        ProductUnitConversion[]

  @@map("product_units")
}

/// Per-product unit conversion. The Unit master (ProductUnit) is only a reusable LABEL (Piece, Box, Carton, Kg…);
/// the factor belongs to the product because one carton can be a different quantity for every product.
/// Exactly one row per product is the BASE unit (isBase, factor 1, = Product.productUnitId). Stock is always
/// stored and protected in base units. A row that any document line or stock movement has used is immutable
/// except for deactivation (see lib/product-units.ts). A future barcode can identify product + this row.
model ProductUnitConversion {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId       String
  unit         ProductUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// Base-unit quantity of ONE of this unit (DECIMAL(16,6), strictly positive; the base row is exactly 1).
  factor       Decimal     @db.Decimal(16, 6)
  isBase       Boolean     @default(false)
  active       Boolean     @default(true)
  forSales     Boolean     @default(true)
  forPurchases Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([productId, unitId])
  @@index([unitId])
  @@map("product_unit_conversions")
}

/// Suppliers (master data) managed on /suppliers. `name` is unique (case-insensitive collation).
/// Purchases and supplier payments will reference suppliers; deletion is refused while they do
/// (see app/(dashboard)/suppliers/actions.ts).
model Supplier {
  id               String              @id @default(cuid())
  name             String              @unique @db.VarChar(120)
  email            String              @db.VarChar(191)
  phoneNumber      String              @db.VarChar(32)
  /// ISO 3166-1 alpha-2 code (see lib/countries.ts).
  countryCode      String              @db.Char(2)
  city             String              @db.VarChar(120)
  address          String              @db.VarChar(255)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  stockEntries     ProductStockEntry[]
  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]
  supplierPayments SupplierPayment[]

  @@map("suppliers")
}

/// Customers (master data) managed on /customers. `name` is unique (case-insensitive collation).
/// Sales, quotations, customer payments and statements will reference customers; deletion must be
/// refused while they do (see app/(dashboard)/customers/actions.ts).
model Customer {
  id               String            @id @default(cuid())
  name             String            @unique @db.VarChar(120)
  email            String            @db.VarChar(191)
  phoneNumber      String            @db.VarChar(32)
  /// ISO 3166-1 alpha-2 code (see lib/countries.ts).
  countryCode      String            @db.Char(2)
  city             String            @db.VarChar(120)
  address          String            @db.VarChar(500)
  /// Optional; a past (or today's) date.
  dateOfBirth      DateTime?         @db.Date
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quotations       Quotation[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  customerPayments CustomerPayment[]
  posWalkInIn      SystemSettings[]  @relation("PosWalkInCustomer")

  @@map("customers")
}

enum BarcodeSymbology {
  CODE128
  CODE39
}

enum TaxType {
  EXCLUSIVE
  INCLUSIVE
}

enum StockEntryStatus {
  RECEIVED
  PENDING
  ORDERED
}

/// Where a stock entry came from. PRODUCT_FORM: opening stock typed in Create Product (recorded against a
/// supplier, as before). INITIAL_STOCK: initial inventory the business already owns, added by the CSV
/// product import — no supplier, no purchase, no payable, no financial entry.
enum StockEntrySource {
  PRODUCT_FORM
  INITIAL_STOCK
}

/// Products managed on /products. Money uses DECIMAL(14,2) and quantities DECIMAL(14,3) — never
/// floating point. All master-data relations are RESTRICT so referenced records can't be deleted.
model Product {
  id                  String                  @id @default(cuid())
  name                String                  @db.VarChar(191)
  /// Normalized (trimmed, uppercase) and unique.
  code                String                  @unique @db.VarChar(64)
  categoryId          String
  category            ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId             String
  brand               Brand                   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  barcodeSymbology    BarcodeSymbology
  cost                Decimal                 @db.Decimal(14, 2)
  price               Decimal                 @db.Decimal(14, 2)
  productUnitId       String
  productUnit         ProductUnit             @relation("ProductUnit", fields: [productUnitId], references: [id], onDelete: Restrict)
  saleUnitId          String
  saleUnit            ProductUnit             @relation("SaleUnit", fields: [saleUnitId], references: [id], onDelete: Restrict)
  purchaseUnitId      String
  purchaseUnit        ProductUnit             @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id], onDelete: Restrict)
  stockAlert          Decimal                 @default(0) @db.Decimal(14, 3)
  /// Percentage 0–100.
  orderTax            Decimal                 @default(0) @db.Decimal(5, 2)
  taxType             TaxType                 @default(EXCLUSIVE)
  quantityLimitation  Decimal?                @db.Decimal(14, 3)
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  images              ProductImage[]
  stocks              ProductStock[]
  stockEntries        ProductStockEntry[]
  unitConversions     ProductUnitConversion[]
  transferItems       StockTransferItem[]
  adjustmentItems     StockAdjustmentItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  quotationItems      QuotationItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

/// Product image: relative path under /uploads/products (local-development storage).
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String   @db.VarChar(255)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

/// Current on-hand quantity per product and warehouse ("In Stock"). Only RECEIVED stock entries
/// (and, later, stock adjustments / purchases / sales) change it.
model ProductStock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Decimal   @default(0) @db.Decimal(14, 3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("product_stocks")
}

/// Opening stock recorded when a product is created (at most one per product). PENDING / ORDERED entries
/// do not change ProductStock; later stock changes belong to a Stock Adjustments module.
model ProductStockEntry {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// Required for PRODUCT_FORM entries; always NULL for INITIAL_STOCK (enforced in createProductRecord,
  /// the only writer). Entries are immutable: nothing in the app updates or deletes them.
  supplierId  String?
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quantity    Decimal          @db.Decimal(14, 3)
  status      StockEntryStatus
  source      StockEntrySource @default(PRODUCT_FORM)
  /// The user who recorded it (audit; not a foreign key so users can be managed independently).
  createdById String?          @db.VarChar(191)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([productId])
  @@index([warehouseId])
  @@index([supplierId])
  @@map("product_stock_entries")
}

enum TransferStatus {
  PENDING
  SENT
  COMPLETED
}

/// Inventory transfer between two warehouses (/transfers). Stock effects (applied atomically in
/// app/(dashboard)/transfers/actions.ts): PENDING none; SENT deducts the source; COMPLETED deducts
/// the source (unless already SENT) and adds to the destination. SENT/COMPLETED rows are inventory
/// history and are never deleted; COMPLETED rows are immutable.
model StockTransfer {
  id              String              @id @default(cuid())
  /// Sequential number behind the reference. MySQL AUTO_INCREMENT: concurrency-safe and never
  /// reused, even after a pending transfer is deleted.
  number          Int                 @unique @default(autoincrement())
  /// "TR_000001" — generated server-side from `number`.
  reference       String              @unique @db.VarChar(20)
  transferDate    DateTime            @db.Date
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  status          TransferStatus
  note            String?             @db.Text
  /// The user who created it (audit; not a foreign key, like ProductStockEntry.createdById).
  createdById     String?             @db.VarChar(191)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           StockTransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

/// One product line of a transfer. `unitCost` is a snapshot of Product.cost when the line was saved.
model StockTransferItem {
  id           String        @id @default(cuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Decimal       @db.Decimal(14, 3)
  /// Unit snapshot of this line (NULL unitId = legacy line, factor 1); baseQuantity is the stock effect.
  unitId       String?       @db.VarChar(191)
  unitName     String?       @db.VarChar(64)
  unitFactor   Decimal       @default(1) @db.Decimal(16, 6)
  baseQuantity Decimal       @db.Decimal(14, 3)
  unitCost     Decimal       @db.Decimal(14, 2)

  @@unique([transferId, productId])
  @@index([productId])
  @@map("stock_transfer_items")
}

enum AdjustmentType {
  ADDITION
  SUBTRACTION
}

/// Manual stock correction for one warehouse (/adjustments). Each item adds to or subtracts from
/// ProductStock; create/edit/delete apply (or reverse) the net effect in one transaction, and stock
/// can never go below zero (app/(dashboard)/adjustments/actions.ts).
model StockAdjustment {
  id             String                @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number         Int                   @unique @default(autoincrement())
  /// "AD_000001" — generated server-side from `number`.
  reference      String                @unique @db.VarChar(20)
  warehouseId    String
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  adjustmentDate DateTime              @db.Date
  /// The user who created it (audit; not a foreign key, like StockTransfer.createdById).
  createdById    String?               @db.VarChar(191)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          StockAdjustmentItem[]

  @@index([warehouseId])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String          @id @default(cuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(14, 3)
  /// Unit snapshot of this line (NULL unitId = legacy line, factor 1); baseQuantity is the stock effect.
  unitId       String?         @db.VarChar(191)
  unitName     String?         @db.VarChar(64)
  unitFactor   Decimal         @default(1) @db.Decimal(16, 6)
  baseQuantity Decimal         @db.Decimal(14, 3)
  type         AdjustmentType

  @@unique([adjustmentId, productId])
  @@index([productId])
  @@map("stock_adjustment_items")
}

/// Expense categories (/expenses/categories). `name` is unique (case-insensitive collation).
/// Expenses will reference categories; deletion must be refused while they do
/// (see app/(dashboard)/expenses/categories/actions.ts).
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@map("expense_categories")
}

/// Expenses (/expenses). Every expense is paid from a cash/bank account: creating one appends a
/// WITHDRAWAL (purpose "Operating Expense") to the ledger. The ledger stays append-only — editing
/// appends a reversal DEPOSIT plus a new WITHDRAWAL; deleting appends a reversal and sets
/// deletedAt (soft delete; the row and its ledger history are kept). See expenses/actions.ts.
model Expense {
  id                  String                @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number              Int                   @unique @default(autoincrement())
  /// "EX_000001" — generated server-side from `number`.
  reference           String                @unique @db.VarChar(20)
  expenseDate         DateTime              @db.Date
  title               String                @db.VarChar(191)
  warehouseId         String
  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  categoryId          String
  category            ExpenseCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cashBankAccountId   String
  cashBankAccount     CashBankAccount       @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  amount              Decimal               @db.Decimal(14, 2)
  details             String?               @db.Text
  /// The user who created it (audit; not a foreign key, like other modules).
  createdById         String?               @db.VarChar(191)
  /// Soft delete: set when the expense is deleted (and reversed). Hidden from the list.
  deletedAt           DateTime?
  /// The ledger WITHDRAWAL currently representing this expense (null once deleted).
  activeTransactionId String?               @unique
  activeTransaction   CashBankTransaction?  @relation("ExpenseActiveTransaction", fields: [activeTransactionId], references: [id], onDelete: Restrict)
  /// Every ledger row this expense ever produced (withdrawals and reversals), oldest first.
  ledgerEntries       CashBankTransaction[] @relation("ExpenseLedger")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([warehouseId])
  @@index([categoryId])
  @@index([cashBankAccountId])
  @@index([deletedAt])
  @@map("expenses")
}

enum PurchaseStatus {
  RECEIVED
  PENDING
  ORDERED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

/// Purchases (/purchases). Totals are computed on the server (lib/purchase-calc.ts) and stored as
/// a snapshot. RECEIVED adds the line quantities to ProductStock in the warehouse exactly once
/// (on creation, or later via "Mark as Received"); PENDING/ORDERED change no stock. Payments come
/// later (Supplier Payments): paidAmount stays 0 for now, so every purchase is Unpaid.
model Purchase {
  id                 String                      @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number             Int                         @unique @default(autoincrement())
  /// "PU_000001" — generated server-side from `number`.
  reference          String                      @unique @db.VarChar(20)
  purchaseDate       DateTime                    @db.Date
  supplierId         String
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId        String
  warehouse          Warehouse                   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status             PurchaseStatus
  /// The System Settings default currency when the purchase was recorded.
  currencyId         String
  currency           Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  /// Σ line subtotals.
  subtotal           Decimal                     @db.Decimal(14, 2)
  /// Order tax percentage (0–100) and the resulting amount.
  orderTaxRate       Decimal                     @default(0) @db.Decimal(5, 2)
  orderTaxAmount     Decimal                     @default(0) @db.Decimal(14, 2)
  discount           Decimal                     @default(0) @db.Decimal(14, 2)
  shipping           Decimal                     @default(0) @db.Decimal(14, 2)
  /// subtotal + orderTaxAmount − discount + shipping.
  grandTotal         Decimal                     @db.Decimal(14, 2)
  /// Supplier payments are not built yet: always 0 for now (due = grandTotal − paidAmount).
  paidAmount         Decimal                     @default(0) @db.Decimal(14, 2)
  notes              String?                     @db.Text
  /// When stock was added (status became RECEIVED) and by whom.
  receivedAt         DateTime?
  receivedById       String?                     @db.VarChar(191)
  /// The user who created it (audit; not a foreign key, like other modules).
  createdById        String?                     @db.VarChar(191)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  items              PurchaseItem[]
  returns            PurchaseReturn[]
  paymentAllocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchases")
}

/// One product line. All amounts are snapshots computed on the server; the purchase line never
/// changes the Product's own cost, tax or discount settings.
model PurchaseItem {
  id             String               @id @default(cuid())
  purchaseId     String
  purchase       Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal              @db.Decimal(14, 3)
  /// Unit snapshot of this line (NULL unitId = legacy line, factor 1); baseQuantity is the stock effect.
  unitId         String?              @db.VarChar(191)
  unitName       String?              @db.VarChar(64)
  unitFactor     Decimal              @default(1) @db.Decimal(16, 6)
  baseQuantity   Decimal              @db.Decimal(14, 3)
  /// Unit cost entered for this purchase (defaults to Product.cost).
  unitCost       Decimal              @db.Decimal(14, 2)
  taxType        TaxType
  /// Line tax percentage (0–100).
  taxRate        Decimal              @db.Decimal(5, 2)
  discountType   DiscountType
  /// FIXED: an amount; PERCENTAGE: a percentage (0–100).
  discountValue  Decimal              @db.Decimal(14, 2)
  discountAmount Decimal              @db.Decimal(14, 2)
  taxAmount      Decimal              @db.Decimal(14, 2)
  /// subtotal ÷ quantity.
  netUnitCost    Decimal              @db.Decimal(14, 2)
  subtotal       Decimal              @db.Decimal(14, 2)
  returnItems    PurchaseReturnItem[]

  @@unique([purchaseId, productId])
  @@index([productId])
  @@map("purchase_items")
}

enum PurchaseReturnStatus {
  COMPLETED
}

/// Purchase returns (/purchases/returns). Always linked to one RECEIVED purchase. Immutable: the
/// stock deduction happens in the same transaction that creates the return, and every amount is a
/// server-computed snapshot prorated from the original purchase lines (lib/purchase-return-calc.ts).
/// The return reduces the purchase's outstanding Due; no Cash/Bank ledger rows are written
/// (Supplier Payments will settle money later).
model PurchaseReturn {
  id             String               @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number         Int                  @unique @default(autoincrement())
  /// "PR_000001" — generated server-side from `number`.
  reference      String               @unique @db.VarChar(20)
  returnDate     DateTime             @db.Date
  purchaseId     String
  purchase       Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// Copied from the purchase (never from the browser) so lists and deletion checks are simple.
  supplierId     String
  supplier       Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  currencyId     String
  currency       Currency             @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  status         PurchaseReturnStatus @default(COMPLETED)
  subtotal       Decimal              @db.Decimal(14, 2)
  orderTaxAmount Decimal              @db.Decimal(14, 2)
  discount       Decimal              @db.Decimal(14, 2)
  /// Shipping is not returned (always 0; kept for the design's summary).
  shipping       Decimal              @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal              @db.Decimal(14, 2)
  notes          String?              @db.Text
  createdById    String?              @db.VarChar(191)
  createdAt      DateTime             @default(now())
  items          PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([warehouseId])
  @@map("purchase_returns")
}

/// One returned line: a snapshot of the original purchase line's pricing plus the prorated amounts.
model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItemId String
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal        @db.Decimal(14, 3)
  /// Unit snapshot of this line (NULL unitId = legacy line, factor 1); baseQuantity is the stock effect.
  unitId         String?        @db.VarChar(191)
  unitName       String?        @db.VarChar(64)
  unitFactor     Decimal        @default(1) @db.Decimal(16, 6)
  baseQuantity   Decimal        @db.Decimal(14, 3)
  unitCost       Decimal        @db.Decimal(14, 2)
  netUnitCost    Decimal        @db.Decimal(14, 2)
  taxType        TaxType
  taxRate        Decimal        @db.Decimal(5, 2)
  discountType   DiscountType
  discountValue  Decimal        @db.Decimal(14, 2)
  discountAmount Decimal        @db.Decimal(14, 2)
  taxAmount      Decimal        @db.Decimal(14, 2)
  subtotal       Decimal        @db.Decimal(14, 2)

  @@unique([returnId, purchaseItemId])
  @@index([purchaseItemId])
  @@index([productId])
  @@map("purchase_return_items")
}

/// Supplier payments (/supplier-payments). Immutable. Each payment is allocated in full to one or
/// more of the supplier's purchases (amount = Σ allocations, exactly) and produces exactly ONE
/// append-only Cash/Bank WITHDRAWAL linked via CashBankTransaction.supplierPaymentId. Every
/// allocation also increments Purchase.paidAmount in the same transaction (see actions.ts).
model SupplierPayment {
  id                String                      @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number            Int                         @unique @default(autoincrement())
  /// "SP_000001" — generated server-side from `number`.
  reference         String                      @unique @db.VarChar(20)
  paymentDate       DateTime                    @db.Date
  supplierId        String
  supplier          Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  cashBankAccountId String
  cashBankAccount   CashBankAccount             @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  /// The paying account's currency (= every allocated purchase's currency).
  currencyId        String
  currency          Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  /// Σ allocations.
  amount            Decimal                     @db.Decimal(14, 2)
  paymentMethod     String                      @db.VarChar(32)
  /// The design's optional "Reference / Transaction Number" (e.g. a cheque or bank transfer number).
  externalReference String?                     @db.VarChar(64)
  notes             String?                     @db.Text
  createdById       String?                     @db.VarChar(191)
  createdAt         DateTime                    @default(now())
  allocations       SupplierPaymentAllocation[]
  ledgerEntry       CashBankTransaction?        @relation("SupplierPaymentLedger")

  @@index([supplierId])
  @@index([cashBankAccountId])
  @@map("supplier_payments")
}

/// The part of a supplier payment applied to one purchase (immutable).
model SupplierPaymentAllocation {
  id         String          @id @default(cuid())
  paymentId  String
  payment    SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseId String
  purchase   Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  amount     Decimal         @db.Decimal(14, 2)

  @@unique([paymentId, purchaseId])
  @@index([purchaseId])
  @@map("supplier_payment_allocations")
}

enum CashBankAccountType {
  CASH
  BANK
}

enum CashBankAccountStatus {
  ACTIVE
  INACTIVE
}

enum CashBankTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

/// Cash registers / cash accounts / bank accounts (/finance/accounts). There is NO stored balance:
/// the current balance is always openingBalance + deposits − withdrawals − transfers out +
/// transfers in, computed from CashBankTransaction rows. Accounts are deactivated, never deleted.
model CashBankAccount {
  id               String                 @id @default(cuid())
  /// Unique (case-insensitive column collation).
  name             String                 @unique @db.VarChar(120)
  type             CashBankAccountType
  /// Bank: account number (required). Cash: optional register/reference code.
  reference        String?                @db.VarChar(64)
  /// Required for BANK accounts, null for CASH.
  bankName         String?                @db.VarChar(120)
  /// The System Settings default currency at creation time (read-only afterwards).
  currencyId       String
  currency         Currency               @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  /// Set once on creation; never edited.
  openingBalance   Decimal                @db.Decimal(14, 2)
  status           CashBankAccountStatus  @default(ACTIVE)
  notes            String?                @db.Text
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  transactions     CashBankTransaction[]  @relation("CashBankSource")
  transfersIn      CashBankTransaction[]  @relation("CashBankDestination")
  expenses         Expense[]
  supplierPayments SupplierPayment[]
  customerPayments CustomerPayment[]
  registerSessions CashRegisterSession[]
  movementsFrom    CashRegisterMovement[] @relation("RegisterMovementFrom")
  movementsTo      CashRegisterMovement[] @relation("RegisterMovementTo")

  @@map("cash_bank_accounts")
}

/// Append-only cash/bank ledger (/finance/transactions): no edits, no deletes. DEPOSIT adds to
/// `account`; WITHDRAWAL subtracts from it; TRANSFER moves `amount` from `account` to
/// `destinationAccount`. Written only inside a transaction that locks the account rows.
model CashBankTransaction {
  id                   String                  @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number               Int                     @unique @default(autoincrement())
  /// "DEP_000001" / "WDR_000002" / "TRF_000003" — generated server-side from `number`.
  reference            String                  @unique @db.VarChar(20)
  transactionDate      DateTime                @db.Date
  type                 CashBankTransactionType
  accountId            String
  account              CashBankAccount         @relation("CashBankSource", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccountId String?
  destinationAccount   CashBankAccount?        @relation("CashBankDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  /// Always positive; the type decides the direction.
  amount               Decimal                 @db.Decimal(14, 2)
  paymentMethod        String?                 @db.VarChar(32)
  purpose              String?                 @db.VarChar(64)
  notes                String?                 @db.Text
  /// The user who recorded it (audit; not a foreign key, like StockTransfer.createdById).
  createdById          String?                 @db.VarChar(191)
  /// Set (at creation only) when the row was produced by an Expense: its withdrawal or a reversal.
  expenseId            String?
  expense              Expense?                @relation("ExpenseLedger", fields: [expenseId], references: [id], onDelete: Restrict)
  activeForExpense     Expense?                @relation("ExpenseActiveTransaction")
  supplierPaymentId    String?                 @unique
  supplierPayment      SupplierPayment?        @relation("SupplierPaymentLedger", fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  /// Set (at creation only) on the one DEPOSIT produced by a customer payment.
  customerPaymentId    String?                 @unique
  customerPayment      CustomerPayment?        @relation("CustomerPaymentLedger", fields: [customerPaymentId], references: [id], onDelete: Restrict)
  registerMovement     CashRegisterMovement?
  createdAt            DateTime                @default(now())

  @@index([expenseId])
  @@index([accountId])
  @@index([destinationAccountId])
  @@index([transactionDate])
  @@map("cash_bank_transactions")
}

/// A user's personal appearance preference (one per user). Takes precedence over the Owner's
/// global theme for that user only.
model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Validated ThemeState JSON (see lib/theme.ts). Null when the user only saved a language.
  theme     Json?
  /// The user's UI language ("en" | "ar"); null = no choice yet (cookie / English default apply).
  locale    String?  @db.VarChar(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

/// Owner-managed Arabic text overrides. English is never stored; the default Arabic lives in code (ar.ts).
/// `key` is a stable dictionary path validated against the server-owned catalog (lib/i18n/catalog.ts).
model TranslationOverride {
  id          String   @id @default(cuid())
  locale      String   @db.VarChar(5)
  key         String   @db.VarChar(120)
  text        String   @db.VarChar(1000)
  /// Audit only: kept (set NULL) when the user is deleted.
  updatedById String?
  updatedBy   User?    @relation("TranslationOverrideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([locale, key])
  @@index([updatedById])
  @@map("translation_overrides")
}

/// Global system settings: a singleton row (id is always 1), edited by administrators on /settings.
/// Default customer / warehouse are added once the Customer and Warehouse models exist.
model SystemSettings {
  id                  Int       @id @default(1)
  /// The default Currency record (required in the form; null only until a currency exists).
  /// Restrict: the database refuses to delete the currency selected here.
  defaultCurrencyId   String?
  defaultCurrency     Currency? @relation("DefaultCurrency", fields: [defaultCurrencyId], references: [id], onDelete: Restrict)
  /// Optional POS Walk-in Customer: a REAL customer chosen by the Owner (never auto-created). Restrict:
  /// the database refuses to delete the customer selected here, so this can never point at a stale row.
  posWalkInCustomerId String?
  posWalkInCustomer   Customer? @relation("PosWalkInCustomer", fields: [posWalkInCustomerId], references: [id], onDelete: Restrict)
  defaultEmail        String?   @db.VarChar(191)
  currencyIconRight   Boolean   @default(false)
  /// Relative path under /uploads/logos (local-development storage), or null.
  companyLogo         String?   @db.VarChar(255)
  companyName         String    @db.VarChar(120)
  companyPhone        String?   @db.VarChar(32)
  developedBy         String?   @db.VarChar(120)
  footerText          String?   @db.VarChar(255)
  /// ISO 3166-1 alpha-2 code, e.g. "EG".
  country             String    @db.Char(2)
  state               String    @db.VarChar(120)
  city                String?   @db.VarChar(120)
  postalCode          String?   @db.VarChar(20)
  dateFormat          String    @db.VarChar(16)
  address             String?   @db.VarChar(500)
  showVersionInFooter Boolean   @default(false)
  /// Owner's global theme override (validated ThemeState JSON, see lib/theme.ts); null = Bluepiller defaults.
  theme               Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------------------------------
// Quotations (design/Quotations.html, Create Quotation.html, Quotation Details.html).
// A commercial offer only: never touches stock, cash/bank, ledger, purchase dues or customer
// balances. Lifecycle: DRAFT → SENT → ACCEPTED | REJECTED | EXPIRED (server-enforced; only DRAFT
// is editable/deletable). Totals and every line are server-computed snapshots.
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id                String          @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible, e.g. deleted drafts).
  number            Int             @unique @default(autoincrement())
  /// "QU_000001" — generated server-side from `number`.
  reference         String          @unique @db.VarChar(20)
  quotationDate     DateTime        @db.Date
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// The warehouse the offer is made from (design field; display/stock reference only — no stock moves).
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status            QuotationStatus @default(DRAFT)
  /// The System Settings default currency when the quotation was created.
  currencyId        String
  currency          Currency        @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  /// Σ line subtotals.
  subtotal          Decimal         @db.Decimal(14, 2)
  orderTaxRate      Decimal         @default(0) @db.Decimal(5, 2)
  orderTaxAmount    Decimal         @default(0) @db.Decimal(14, 2)
  discount          Decimal         @default(0) @db.Decimal(14, 2)
  shipping          Decimal         @default(0) @db.Decimal(14, 2)
  /// subtotal + orderTaxAmount − discount + shipping.
  grandTotal        Decimal         @db.Decimal(14, 2)
  notes             String?         @db.Text
  /// Audit (not foreign keys, like other modules).
  createdById       String?         @db.VarChar(191)
  statusChangedAt   DateTime?
  statusChangedById String?         @db.VarChar(191)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             QuotationItem[]
  /// The sale created from this (Accepted) quotation — at most one.
  sale              Sale?

  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@index([quotationDate])
  @@map("quotations")
}

/// One quoted product. Values are this quotation's own snapshot (never written back to Product).
model QuotationItem {
  id             String       @id @default(cuid())
  quotationId    String
  quotation      Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Product identity at the time of quoting.
  productCode    String       @db.VarChar(64)
  productName    String       @db.VarChar(191)
  unitName       String       @db.VarChar(64)
  quantity       Decimal      @db.Decimal(14, 3)
  /// Selling price for this quotation (defaults to Product.price).
  unitPrice      Decimal      @db.Decimal(14, 2)
  taxType        TaxType
  taxRate        Decimal      @db.Decimal(5, 2)
  discountType   DiscountType
  /// FIXED: an amount; PERCENTAGE: a percentage (0–100).
  discountValue  Decimal      @db.Decimal(14, 2)
  discountAmount Decimal      @db.Decimal(14, 2)
  taxAmount      Decimal      @db.Decimal(14, 2)
  /// subtotal ÷ quantity.
  netUnitPrice   Decimal      @db.Decimal(14, 2)
  subtotal       Decimal      @db.Decimal(14, 2)

  @@unique([quotationId, productId])
  @@index([productId])
  @@map("quotation_items")
}

// ---------------------------------------------------------------------------------------------
// Sales (design/Sales.html, Create Sale.html, Sale Details.html) — the shared sales engine (future
// POS reuses it). PENDING: a record only (no stock change). COMPLETED: stock is deducted from the
// warehouse exactly once, in the same transaction that completes it; completed sales are immutable.
// No payments yet: paidAmount stays 0 (Due = Grand Total); no cash/bank or ledger rows are written.
// The sale lines are the stock movement record (like purchases, returns, transfers, adjustments).
enum SaleStatus {
  PENDING
  COMPLETED
}

model Sale {
  id                 String                      @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number             Int                         @unique @default(autoincrement())
  /// "SA_000001" — generated server-side from `number`.
  reference          String                      @unique @db.VarChar(20)
  saleDate           DateTime                    @db.Date
  customerId         String
  customer           Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouseId        String
  warehouse          Warehouse                   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status             SaleStatus
  /// Default currency at creation (or the source quotation's currency).
  currencyId         String
  currency           Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  subtotal           Decimal                     @db.Decimal(14, 2)
  orderTaxRate       Decimal                     @default(0) @db.Decimal(5, 2)
  orderTaxAmount     Decimal                     @default(0) @db.Decimal(14, 2)
  discount           Decimal                     @default(0) @db.Decimal(14, 2)
  shipping           Decimal                     @default(0) @db.Decimal(14, 2)
  /// subtotal + orderTaxAmount − discount + shipping.
  grandTotal         Decimal                     @db.Decimal(14, 2)
  /// Customer payments are not built yet: always 0 (Due = grandTotal − paidAmount).
  paidAmount         Decimal                     @default(0) @db.Decimal(14, 2)
  notes              String?                     @db.Text
  /// Set when created from an Accepted quotation; unique → a quotation converts at most once.
  quotationId        String?                     @unique
  quotation          Quotation?                  @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  /// When stock was deducted (status became COMPLETED) and by whom.
  completedAt        DateTime?
  completedById      String?                     @db.VarChar(191)
  createdById        String?                     @db.VarChar(191)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  items              SaleItem[]
  returns            SaleReturn[]
  paymentAllocations CustomerPaymentAllocation[]
  /// Set only on sales created by POS checkout: the idempotency key (unique) that makes a retried or
  /// double-submitted checkout create the sale, stock deduction and payment at most once.
  posCheckoutKey     String?                     @unique @db.VarChar(64)

  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

/// One sold product — this sale's own snapshot (never written back to Product).
model SaleItem {
  id             String           @id @default(cuid())
  saleId         String
  sale           Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productCode    String           @db.VarChar(64)
  productName    String           @db.VarChar(191)
  unitName       String           @db.VarChar(64)
  quantity       Decimal          @db.Decimal(14, 3)
  /// Unit snapshot of this line: the unit used (NULL = legacy line, factor 1), the base-unit quantity of ONE such
  /// unit at the time, and the quantity in BASE units — the only number stock effects and history use.
  unitId         String?          @db.VarChar(191)
  unitFactor     Decimal          @default(1) @db.Decimal(16, 6)
  baseQuantity   Decimal          @db.Decimal(14, 3)
  unitPrice      Decimal          @db.Decimal(14, 2)
  taxType        TaxType
  taxRate        Decimal          @db.Decimal(5, 2)
  discountType   DiscountType
  discountValue  Decimal          @db.Decimal(14, 2)
  discountAmount Decimal          @db.Decimal(14, 2)
  taxAmount      Decimal          @db.Decimal(14, 2)
  netUnitPrice   Decimal          @db.Decimal(14, 2)
  subtotal       Decimal          @db.Decimal(14, 2)
  returnItems    SaleReturnItem[]

  @@unique([saleId, productId])
  @@index([productId])
  @@map("sale_items")
}

// ---------------------------------------------------------------------------------------------
// Sales Returns (design/Sales Returns.html, Create Sale Return.html, Edit Sale Return.html).
// Always linked to one COMPLETED sale. Creating one adds the returned quantities back to the sale's
// warehouse in the same transaction (the return lines are the stock movement record) and reduces the
// sale's Due by its grand total. Amounts are exact shares of the sale's stored snapshot; shipping is
// never returned. No cash/bank, ledger, refund or payment rows. Immutable (no edit/delete).
enum SaleReturnStatus {
  COMPLETED
}

model SaleReturn {
  id             String           @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number         Int              @unique @default(autoincrement())
  /// "SR_000001" — generated server-side from `number`.
  reference      String           @unique @db.VarChar(20)
  returnDate     DateTime         @db.Date
  saleId         String
  sale           Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  /// Copied from the sale (never from the browser).
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  currencyId     String
  currency       Currency         @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  status         SaleReturnStatus @default(COMPLETED)
  subtotal       Decimal          @db.Decimal(14, 2)
  orderTaxAmount Decimal          @db.Decimal(14, 2)
  discount       Decimal          @db.Decimal(14, 2)
  /// Shipping is not returned (always 0; kept for the design's summary).
  shipping       Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal          @db.Decimal(14, 2)
  notes          String?          @db.Text
  createdById    String?          @db.VarChar(191)
  createdAt      DateTime         @default(now())
  items          SaleReturnItem[]

  @@index([saleId])
  @@index([customerId])
  @@index([warehouseId])
  @@map("sale_returns")
}

/// One returned sale line — a snapshot of the original sale line's price/tax/discount/identity.
model SaleReturnItem {
  id             String       @id @default(cuid())
  returnId       String
  saleReturn     SaleReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId     String
  saleItem       SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productCode    String       @db.VarChar(64)
  productName    String       @db.VarChar(191)
  unitName       String       @db.VarChar(64)
  quantity       Decimal      @db.Decimal(14, 3)
  /// Unit snapshot of this line: the unit used (NULL = legacy line, factor 1), the base-unit quantity of ONE such
  /// unit at the time, and the quantity in BASE units — the only number stock effects and history use.
  unitId         String?      @db.VarChar(191)
  unitFactor     Decimal      @default(1) @db.Decimal(16, 6)
  baseQuantity   Decimal      @db.Decimal(14, 3)
  unitPrice      Decimal      @db.Decimal(14, 2)
  netUnitPrice   Decimal      @db.Decimal(14, 2)
  taxType        TaxType
  taxRate        Decimal      @db.Decimal(5, 2)
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(14, 2)
  discountAmount Decimal      @db.Decimal(14, 2)
  taxAmount      Decimal      @db.Decimal(14, 2)
  subtotal       Decimal      @db.Decimal(14, 2)

  @@unique([returnId, saleItemId])
  @@index([saleItemId])
  @@index([productId])
  @@map("sale_return_items")
}

// ---------------------------------------------------------------------------------------------
// Customer Payments (design/Customer Payments.html). A real receipt against COMPLETED sales: one
// immutable payment + immutable allocation rows + exactly ONE append-only Cash/Bank DEPOSIT, all in
// one transaction; each allocated Sale.paidAmount is incremented there too.
// Sale Due = max(0, Grand Total − completed sales-return totals − Paid). No unallocated receipts,
// customer credit or refunds yet. Immutable: no edit/delete (future reversals use compensating rows).
model CustomerPayment {
  id                String                      @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number            Int                         @unique @default(autoincrement())
  /// "CP_000001" — generated server-side from `number`.
  reference         String                      @unique @db.VarChar(20)
  paymentDate       DateTime                    @db.Date
  customerId        String
  customer          Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashBankAccountId String
  cashBankAccount   CashBankAccount             @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  /// The receiving account's currency (= every allocated sale's currency).
  currencyId        String
  currency          Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  /// Σ allocations.
  amount            Decimal                     @db.Decimal(14, 2)
  paymentMethod     String                      @db.VarChar(32)
  /// The design's optional "Payment Reference" (e.g. a cheque or bank transfer number).
  externalReference String?                     @db.VarChar(64)
  notes             String?                     @db.Text
  createdById       String?                     @db.VarChar(191)
  createdAt         DateTime                    @default(now())
  allocations       CustomerPaymentAllocation[]
  ledgerEntry       CashBankTransaction?        @relation("CustomerPaymentLedger")
  /// Set only at creation, only for a POS CASH tender: the register shift it belongs to (immutable).
  registerSessionId String?
  registerSession   CashRegisterSession?        @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([cashBankAccountId])
  @@index([registerSessionId])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  saleId    String
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount    Decimal         @db.Decimal(14, 2)

  @@unique([paymentId, saleId])
  @@index([saleId])
  @@map("customer_payment_allocations")
}

// ---------------------------------------------------------------------------------------------
// POS held orders: a saved POS cart (draft). NOT a sale, payment or ledger entry and it never
// touches stock, money, customer balances or product prices — a held order reserves nothing.
// customer/warehouse/account/product ids are plain strings on purpose (no foreign keys): a draft
// must never block deleting master data, and a deleted/missing/inactive reference is detected and
// reported when the order is resumed (checkout re-reads and re-validates everything anyway).
// Only its creator can read/resume/discard it. Completing a checkout consumes it (same transaction).
enum PosHeldOrderStatus {
  HELD
  CONSUMED
  DISCARDED
}

model PosHeldOrder {
  id                String               @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number            Int                  @unique @default(autoincrement())
  /// "HO_000001" — generated server-side from `number`.
  reference         String               @unique @db.VarChar(20)
  /// Idempotency key of the Hold action: a double-clicked / retried Hold creates one order only.
  holdKey           String               @unique @db.VarChar(64)
  createdById       String               @db.VarChar(191)
  status            PosHeldOrderStatus   @default(HELD)
  customerId        String?              @db.VarChar(191)
  warehouseId       String?              @db.VarChar(191)
  cashBankAccountId String?              @db.VarChar(191)
  paymentMethod     String?              @db.VarChar(32)
  notes             String?              @db.Text
  /// Set when a POS checkout consumed this order (the resulting sale).
  consumedSaleId    String?              @unique @db.VarChar(191)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  items             PosHeldOrderItem[]
  /// Draft payment rows (split payment). Orders held before split payments existed have none and
  /// carry the single account/method in the legacy columns above: they resume as ONE tender.
  tenders           PosHeldOrderTender[]

  @@index([createdById, status])
  @@map("pos_held_orders")
}

model PosHeldOrderItem {
  id          String       @id @default(cuid())
  heldOrderId String
  heldOrder   PosHeldOrder @relation(fields: [heldOrderId], references: [id], onDelete: Cascade)
  productId   String       @db.VarChar(191)
  /// Display snapshots only (the current product is re-read on resume and at checkout).
  productCode String       @db.VarChar(64)
  productName String       @db.VarChar(191)
  quantity    Decimal      @db.Decimal(14, 3)
  /// The selected sale unit (NULL = the product default); validated again at checkout.
  unitId      String?      @db.VarChar(191)
  /// The unit price shown when it was held — informational; checkout always uses the live price.
  unitPrice   Decimal      @db.Decimal(14, 2)

  @@unique([heldOrderId, productId])
  @@map("pos_held_order_items")
}

/// One draft payment row of a held POS order. Plain ids (no foreign keys) and nullable fields on
/// purpose: a draft can be half-filled and must never block deleting an account.
model PosHeldOrderTender {
  id                String       @id @default(cuid())
  heldOrderId       String
  heldOrder         PosHeldOrder @relation(fields: [heldOrderId], references: [id], onDelete: Cascade)
  position          Int
  paymentMethod     String?      @db.VarChar(32)
  cashBankAccountId String?      @db.VarChar(191)
  amount            Decimal?     @db.Decimal(14, 2)

  @@index([heldOrderId])
  @@map("pos_held_order_tenders")
}

// ---------------------------------------------------------------------------------------------
// POS register sessions: one physical cash-drawer SHIFT on a CASH account. Not an accounting
// system: opening/closing writes NO ledger, sale, payment or stock row, and the account balance is
// never touched. Expected Cash = openingCash + Σ POS CASH tenders (customer_payments) linked to this
// session; the whole-account ledger balance is NOT used. Closed sessions are immutable.
// `openAccountKey` = the account id while OPEN and NULL once CLOSED, with a UNIQUE index: MySQL
// lets many NULLs coexist, so an account can have many closed shifts but only ONE open one.
enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegisterSession {
  id                String                 @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number            Int                    @unique @default(autoincrement())
  /// "RS_000001" - generated server-side from `number`.
  reference         String                 @unique @db.VarChar(20)
  cashBankAccountId String
  cashBankAccount   CashBankAccount        @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  status            CashRegisterStatus     @default(OPEN)
  openAccountKey    String?                @unique @db.VarChar(191)
  openingCash       Decimal                @db.Decimal(14, 2)
  openedAt          DateTime               @default(now())
  openedById        String                 @db.VarChar(191)
  openingNotes      String?                @db.Text
  closedAt          DateTime?
  closedById        String?                @db.VarChar(191)
  /// Final snapshot, written once at close.
  closingCash       Decimal?               @db.Decimal(14, 2)
  expectedCash      Decimal?               @db.Decimal(14, 2)
  difference        Decimal?               @db.Decimal(14, 2)
  closingNotes      String?                @db.Text
  tenders           CustomerPayment[]
  movements         CashRegisterMovement[]
  /// Immutable cash-count snapshot taken when the session was closed with denomination counting.
  counts            CashRegisterCount[]

  @@index([cashBankAccountId, status])
  @@map("cash_register_sessions")
}

// Register Cash In / Cash Out: physical cash entering/leaving an OPEN register's drawer, always a
// real balanced internal TRANSFER between the register's CASH account and a counter-account (the
// linked ledger row is `transactionId`). Never revenue/expense/payment. Append-only: no edit/delete.
// Expected Cash = opening + POS CASH tenders + Σ CASH_IN - Σ CASH_OUT (linked to the session only).
enum CashRegisterMovementType {
  CASH_IN
  CASH_OUT
}

model CashRegisterMovement {
  id            String                   @id @default(cuid())
  /// MySQL AUTO_INCREMENT: concurrency-safe and never reused (gaps are possible).
  number        Int                      @unique @default(autoincrement())
  /// "RM_000001" - generated server-side from `number`.
  reference     String                   @unique @db.VarChar(20)
  sessionId     String
  session       CashRegisterSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type          CashRegisterMovementType
  amount        Decimal                  @db.Decimal(14, 2)
  fromAccountId String
  fromAccount   CashBankAccount          @relation("RegisterMovementFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     CashBankAccount          @relation("RegisterMovementTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  /// The ledger TRANSFER row this movement created (one-to-one, immutable).
  transactionId String                   @unique
  transaction   CashBankTransaction      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  notes         String                   @db.Text
  createdAt     DateTime                 @default(now())
  createdById   String                   @db.VarChar(191)

  @@index([sessionId])
  @@map("cash_register_movements")
}

// Cash denominations per currency (banknotes/coins) used to COUNT the drawer when closing a register.
// Entered by the Owner (never seeded). A denomination used by a closed count is inactivated, not
// deleted. Closed sessions keep their own snapshot rows (CashRegisterCount), so later edits never
// change history.
model CurrencyDenomination {
  id         String   @id @default(cuid())
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  value      Decimal  @db.Decimal(14, 2)
  label      String?  @db.VarChar(60)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([currencyId, value])
  @@map("currency_denominations")
}

/// One line of a closed session cash count: a SNAPSHOT of the denomination value/label, the counted
/// quantity and the line total (value x count). `denominationId` is a plain reference (no foreign key)
/// used only to know a denomination has been used.
model CashRegisterCount {
  id             String              @id @default(cuid())
  sessionId      String
  session        CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  denominationId String?             @db.VarChar(191)
  value          Decimal             @db.Decimal(14, 2)
  label          String?             @db.VarChar(60)
  count          Int
  lineTotal      Decimal             @db.Decimal(14, 2)

  @@index([sessionId])
  @@index([denominationId])
  @@map("cash_register_counts")
}
